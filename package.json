{
  "name": "zedalleys-website",
  "private": true,
  "description": "Zed Alleys — personal portfolio site (Eleventy → static HTML/CSS/JS, deployed via GitHub Pages)",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "build": "npm run assets && eleventy",
    "watch": "eleventy --serve",
    "lint": "eslint scripts/*.js",
    "format": "prettier --write \"**/*.{css,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{css,js,mjs}\"",
    "validate": "html-validate \"*.html\" \"journal/**/*.html\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "eslint": "^10.10.0",
    "html-validate": "^11.13.0",
    "luxon": "^3.7.2",
    "prettier": "^3.3.3",
    "sharp": "^0.35.4"
  }
}
